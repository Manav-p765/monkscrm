# =============================================================================
# Monks CRM - environment configuration
# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Monks CRM"
# local | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# MUST be false in production. The app refuses to boot if APP_ENV=production and APP_DEBUG=true.
APP_DEBUG=true
# Production: https://crm.hybridmonks.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

# Comma-separated IPs/CIDRs of your reverse proxy / load balancer, if any.
# Needed so client IPs (last_login_ip, audit log) and HTTPS detection are correct.
# Leave empty if PHP is served directly.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning or error
LOG_LEVEL=debug

# --- Database (MySQL 8) ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hybridmonks_crm
DB_USERNAME=crm
DB_PASSWORD=

# --- Sessions ----------------------------------------------------------------
SESSION_DRIVER=database
# Idle timeout in minutes.
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production. Set true anywhere you serve over HTTPS.
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Seconds before "confirm your password" is asked again for sensitive actions (e.g. 2FA changes).
AUTH_PASSWORD_TIMEOUT=900

# --- Cache / queue -----------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (SMTP, used for password reset emails) -----------------------------
# Local: "log" writes emails to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crm@hybridmonks.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
