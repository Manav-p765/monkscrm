# =============================================================================
# HybridMonks CRM - environment configuration
# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="HybridMonks CRM"
# Demo site only (a separate deployment with its own empty database, never production):
# neutral logo/icons, and DemoSeeder is allowed. Set APP_NAME="Demo CRM" there too.
# DEMO_MODE=true
# Optional shared password for the demo users (otherwise a random one is printed once when seeding).
# DEMO_PASSWORD=
# local | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# MUST be false in production. The app refuses to boot if APP_ENV=production and APP_DEBUG=true.
APP_DEBUG=true
# Production: https://crm.hybridmonks.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

# Comma-separated IPs/CIDRs of your reverse proxy / load balancer, if any.
# Needed so client IPs (last_login_ip, audit log) and HTTPS detection are correct.
# Leave empty if PHP is served directly. On Render use "*": the container is only
# reachable through Render's load balancer.
TRUSTED_PROXIES=

# 10: still well above the OWASP minimum, and ~4x faster on Render's small CPU. Old hashes are
# upgraded/downgraded automatically at the next sign-in.
BCRYPT_ROUNDS=10

# --- Logging -----------------------------------------------------------------
# Production (Render): LOG_CHANNEL=stderr. The container filesystem is ephemeral.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning or error
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---------------------------------------------------
# Local PostgreSQL:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monks_crm
DB_USERNAME=postgres
DB_PASSWORD=
# disable/prefer locally; production MUST be "require".
DB_SSLMODE=prefer

# Production (Neon, Singapore): set ONE connection URL instead of DB_HOST..DB_PASSWORD.
# Set it as a secret env var in Render; never commit it. Shape only, not a real value:
#   DB_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   Use the DIRECT url (no "-pooler"): the pooler breaks prepared statements in transactions.
DB_URL=

# --- Sessions ----------------------------------------------------------------
SESSION_DRIVER=database
# Idle timeout in minutes (10080 = 7 days).
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production. Set true anywhere you serve over HTTPS.
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Seconds before "confirm your password" is asked again for sensitive actions (e.g. 2FA changes).
AUTH_PASSWORD_TIMEOUT=900

# --- Cache / queue -----------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (invites and password reset emails) --------------------------------
# Local: "log" writes emails to storage/logs instead of sending them.
# Production: MAIL_MAILER=resend + RESEND_API_KEY (set as a Render env var, never committed).
# MAIL_FROM_ADDRESS must be on a domain verified in Resend.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hybridmonks.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
