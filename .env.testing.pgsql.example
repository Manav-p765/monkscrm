# Copy to .env.testing.pgsql (gitignored) to run the test suite against PostgreSQL:
#   composer test:pgsql
# Use a DEDICATED test database: every test run drops and recreates all its tables.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monks_crm_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_URL=
